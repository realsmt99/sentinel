# Copy to .env and fill in. Never commit .env.

# Aiven for PostgreSQL - use the direct service URI (not the PgBouncer pool) so LISTEN/NOTIFY works
DATABASE_URL=postgres://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require

# Keenable live web intelligence (https://keenable.ai/console)
# Optional: Keenable works keyless on the public tier - leave empty to use it without a key (keys look like keen_xxx)
KEENABLE_API_KEY=

# LLM keys - every agent runs on the OpenAI Agents SDK; ANTHROPIC_API_KEY is unused in this build
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Agent models - placeholders: check which models your key can use
# (curl -s https://api.openai.com/v1/models -H "Authorization: Bearer $OPENAI_API_KEY")
# FAST: Triage, Risk Scoring, Containment. SMART: Threat Intel, Remediation.
OPENAI_MODEL_FAST=gpt-5-mini
OPENAI_MODEL_SMART=gpt-5

# GitHub PRs opened by the agent (fine-grained token: contents + pull requests read/write)
GITHUB_TOKEN=
GITHUB_REPO=your-user/sentinel

# Phone alerts via https://ntfy.sh - pick a hard-to-guess topic name
NTFY_TOPIC=sentinel-change-me

# Sentinel FastAPI base URL - the dashboard proxies its action buttons here
AGENT_URL=http://localhost:8000

# 1 = Threat Intel loads sentinel/fixtures/php2shell-intel.json instead of live research (demo fallback)
INTEL_OFFLINE=0
